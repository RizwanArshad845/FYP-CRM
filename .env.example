# Copy to .env for local development. On Vercel, set these in Project Settings → Environment Variables.

# Postgres connection string (Supabase: use the pooler URL). Use a separate dev/test project, never production.
DATABASE_URL=postgresql://postgres:password@localhost:5432/crm

# Long random string, e.g. `openssl rand -hex 32`. The API refuses to start without it.
JWT_SECRET=

# Optional
# JWT_EXPIRES_IN=24h
# PORT=5000
# DB_POOL_MAX=5
# Set to false for a local Postgres without TLS
# DB_SSL=false
# Only needed if the frontend is served from a different origin than the API
# ALLOWED_ORIGINS=http://localhost:5173

# Frontend (Vite). Defaults to same-origin /api, which works on Vercel and with the dev proxy.
# VITE_API_URL=
